<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.jbescos</groupId>
        <artifactId>ratass-parent</artifactId>
        <version>1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ratass-android</artifactId>
    <name>ratass-android</name>
    <packaging>pom</packaging>

    <properties>
        <android.compile.sdk>36</android.compile.sdk>
        <android.target.sdk>36</android.target.sdk>
        <android.min.sdk>21</android.min.sdk>
        <android.build.tools.version>36.0.0</android.build.tools.version>
        <android.version.code>1</android.version.code>
        <android.version.name>${project.version}</android.version.name>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-debug-apk</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>/bin/bash</executable>
                            <arguments>
                                <argument>${project.basedir}/scripts/build-android-debug.sh</argument>
                                <argument>${project.basedir}</argument>
                                <argument>${project.build.directory}</argument>
                                <argument>${project.artifactId}-${project.version}</argument>
                                <argument>${gdx.version}</argument>
                                <argument>${android.compile.sdk}</argument>
                                <argument>${android.target.sdk}</argument>
                                <argument>${android.min.sdk}</argument>
                                <argument>${android.build.tools.version}</argument>
                                <argument>${android.version.code}</argument>
                                <argument>${android.version.name}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>attach-debug-apk</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/${project.artifactId}-${project.version}-debug.apk</file>
                                    <type>apk</type>
                                    <classifier>debug</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>android-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-release-aab</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>/bin/bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/build-android-release.sh</argument>
                                        <argument>${project.basedir}</argument>
                                        <argument>${project.build.directory}</argument>
                                        <argument>${project.artifactId}-${project.version}</argument>
                                        <argument>${gdx.version}</argument>
                                        <argument>${android.compile.sdk}</argument>
                                        <argument>${android.target.sdk}</argument>
                                        <argument>${android.min.sdk}</argument>
                                        <argument>${android.build.tools.version}</argument>
                                        <argument>${android.version.code}</argument>
                                        <argument>${android.version.name}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>attach-release-aab</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>attach-artifact</goal>
                                </goals>
                                <configuration>
                                    <artifacts>
                                        <artifact>
                                            <file>${project.build.directory}/${project.artifactId}-${project.version}-release.aab</file>
                                            <type>aab</type>
                                            <classifier>release</classifier>
                                        </artifact>
                                    </artifacts>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
